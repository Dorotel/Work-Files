<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MTM_Template_Application.Controls">

    <Style Selector="controls|ConfigurationErrorDialog">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemErrorTextColor}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="24"
                        MinWidth="400"
                        MaxWidth="600">
                    <StackPanel Spacing="16">
                        <TextBlock Text="⚠️ Configuration Error" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemErrorTextColor}" />
                        <TextBlock Text="{TemplateBinding ErrorMessage}" TextWrapping="Wrap" />
                        <controls:ActionButtonGroup Buttons="{TemplateBinding RecoveryOptions}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
